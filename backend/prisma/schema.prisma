generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobStatus {
  WISHLIST
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
}

enum InterviewType {
  PHONE
  VIDEO
  ONSITE
  TECHNICAL
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  jobs      Job[]
}

model Job {
  id          String      @id @default(cuid())
  company     String
  position    String
  status      JobStatus   @default(WISHLIST)
  appliedDate DateTime?
  notes       String?
  salary      String?
  location    String?
  url         String?
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  interviews  Interview[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Interview {
  id          String        @id @default(cuid())
  jobId       String
  job         Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  scheduledAt DateTime
  type        InterviewType
  notes       String?
  createdAt   DateTime      @default(now())
}
